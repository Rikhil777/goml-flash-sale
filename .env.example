# Copy to .env and replace the placeholders before starting the local Compose stack.
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=flashsale
POSTGRES_USER=flashsale
POSTGRES_PASSWORD=replace-with-a-local-password
RABBITMQ_USER=flashsale
RABBITMQ_PASSWORD=replace-with-a-local-password
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=30
CELERY_WORKER_CONCURRENCY=2
NGINX_HOST_PORT=8080
NGINX_CHECKOUT_RATE=50r/s
NGINX_CHECKOUT_BURST=200
CHECKOUT_RATE_LIMIT_REQUESTS=100
CHECKOUT_RATE_LIMIT_WINDOW=60
