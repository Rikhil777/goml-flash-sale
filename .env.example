# Copy to .env and replace the placeholders before starting the local Compose stack.
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# For local PostgreSQL, set POSTGRES_DB below. For Render, set DATABASE_URL in the dashboard.
# DATABASE_URL=postgresql://user:password@host:5432/database
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
POSTGRES_DB=flashsale
POSTGRES_USER=flashsale
POSTGRES_PASSWORD=replace-with-a-local-password
RABBITMQ_USER=flashsale
RABBITMQ_PASSWORD=replace-with-a-local-password
# In Render, RABBITMQ_HOST and credentials are supplied by the Blueprint/private service.
# CELERY_BROKER_URL can override the default local RabbitMQ URL when needed.
# CELERY_BROKER_URL=amqp://user:password@localhost:5672//
REDIS_URL=redis://localhost:6379/0
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=30
CELERY_WORKER_CONCURRENCY=2
NGINX_HOST_PORT=8080
NGINX_CHECKOUT_RATE=50r/s
NGINX_CHECKOUT_BURST=200
CHECKOUT_RATE_LIMIT_REQUESTS=100
CHECKOUT_RATE_LIMIT_WINDOW=60
